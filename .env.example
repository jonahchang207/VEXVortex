# .env.example — VEXVortex safe config template (VEX stats app)
# Copy to .env locally and fill in. NEVER commit .env with real values.
# No service_role, DB passwords, Apple keys, or Codemagic secrets belong in git.

# Public / safe to share shape, not values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — set in Supabase / Edge Functions / Codemagic variables, never in the repo
# SUPABASE_SERVICE_ROLE_KEY=

# App environment
APP_ENV=development
# iOS bundle / Codemagic track wiring (values live in Xcode + Codemagic, shown here for shape only)
# IOS_BUNDLE_ID=com.jonahchang207.vexvortex
# CODEMAGIC_TRACK=dev
