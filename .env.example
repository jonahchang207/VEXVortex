# .env.example — VEXVortex safe config template
# Copy to .env locally and fill in. NEVER commit .env with real values.
# No service_role, DB passwords, tunnel tokens, or Tailscale keys belong in git.

# Public / safe to share shape, not values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — set on the host / secret manager, never in the repo
# SUPABASE_SERVICE_ROLE_KEY=
# POSTGRES_PASSWORD=
# CLOUDFLARE_TUNNEL_TOKEN=
# TAILSCALE_AUTH_KEY=

# App environment
APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:3000

# Admin bind — must remain localhost or Tailscale only
ADMIN_BIND_ADDR=127.0.0.1:8080
